{
  "info": {
    "name": "OficioYa - Service (seguridad y solicitudes)",
    "description": "Pruebas de /api/v1/requests con tokens generados automáticamente. Antes de cada corrida ejecutar postman/seed-postman.sql. Ver postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Estado y login",
      "item": [
        {
          "name": "Login (público, devuelve token de prueba)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"prueba@escuelaing.edu.co\",\n  \"password\": \"123456\"\n}"
            },
            "description": "El login es provisional: ignora las credenciales y entrega un token CONTRATANTE con un UUID aleatorio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve accessToken', () => pm.expect(pm.response.json().accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('Tipo Bearer', () => pm.expect(pm.response.json().tipo).to.eql('Bearer'));",
                  "pm.collectionVariables.set('tokenLogin', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con cuerpo inválido -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"no-es-un-correo\",\n  \"password\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Cuerpo JSON con status 400', () => pm.expect(pm.response.json().status).to.eql(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token del login abre GET /requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "requests"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenLogin}}",
                  "type": "string"
                }
              ]
            },
            "description": "Ejecutar después del login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Swagger: /v3/api-docs es público",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Solo pasa con OpenApiConfig instalado y en perfil dev (en prod Swagger está deshabilitado)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un documento OpenAPI', () => pm.expect(pm.response.json().openapi).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
