  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Genera tokens JWT HS256 con la misma clave del servicio (variable jwtSecret) para probar roles sin tocar el código.",
          "const secret = pm.collectionVariables.get('jwtSecret');",
          "const issuer = pm.collectionVariables.get('issuer');",
          "const b64url = (wa) => CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const enc = (obj) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)));",
          "function jwt(sub, role, key, iss, iat, exp) {",
          "  const payload = { sub: sub, iss: iss, iat: iat, exp: exp };",
          "  if (role) { payload.role = role; }",
          "  const body = enc({ alg: 'HS256', typ: 'JWT' }) + '.' + enc(payload);",
          "  return body + '.' + b64url(CryptoJS.HmacSHA256(body, key));",
          "}",
          "const now = Math.floor(Date.now() / 1000);",
          "const ok = now + 1800;",
          "const v = (k) => pm.collectionVariables.get(k);",
          "const set = (k, t) => pm.collectionVariables.set(k, t);",
          "",
          "set('tokenTrabajador',      jwt(v('trabajadorId'),      'TRABAJADOR',  secret, issuer, now, ok));",
          "set('tokenOtroTrabajador',  jwt(v('otroTrabajadorId'),  'TRABAJADOR',  secret, issuer, now, ok));",
          "set('tokenContratante',     jwt(v('contratanteId'),     'CONTRATANTE', secret, issuer, now, ok));",
          "set('tokenOtroContratante', jwt(v('otroContratanteId'), 'CONTRATANTE', secret, issuer, now, ok));",
          "set('tokenAdmin',           jwt(v('adminId'),           'ADMIN',       secret, issuer, now, ok));",
          "set('tokenSinRol',          jwt(v('trabajadorId'),      null,          secret, issuer, now, ok));",
          "set('tokenExpirado',        jwt(v('trabajadorId'),      'TRABAJADOR',  secret, issuer, now - 7200, now - 3600));",
          "set('tokenOtraClave',       jwt(v('trabajadorId'),      'TRABAJADOR',  'otra-clave-distinta-de-al-menos-256-bits-0123456789', issuer, now, ok));",
          "set('tokenOtroEmisor',      jwt(v('trabajadorId'),      'TRABAJADOR',  secret, 'otro-emisor', now, ok));",
          "// Token alterado: payload de CONTRATANTE reescrito como TRABAJADOR, con la firma original (debe rechazarse)",
          "const original = jwt(v('contratanteId'), 'CONTRATANTE', secret, issuer, now, ok).split('.');",
          "const forjado = enc({ sub: v('contratanteId'), iss: issuer, iat: now, exp: ok, role: 'TRABAJADOR' });",
          "set('tokenAlterado', original[0] + '.' + forjado + '.' + original[2]);"
        ]
      }
    }
  ],
