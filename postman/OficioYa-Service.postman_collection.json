                  "pm.test('Respuesta controlada (200, 400, 404 o 409)', () => {",
                  "  pm.expect([200, 400, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "console.log(pm.response.text());"
                ]
              }
            }
