    {
      "name": "Documentacion",
      "item": [
        {
          "name": "OpenAPI JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Tiene ruta de solicitudes', () => pm.expect(data.paths).to.have.property('/api/v1/requests'));",
                  "pm.test('No declara seguridad', () => pm.expect(data.components.securitySchemes).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            }
          },
          "response": []
        },
